# Production: bu fayldan nusxa oling va qiymatlarni serverning o'zida (yoki hosting sozlamalarida) to'ldiring.
# Hech qachon git'ga qo'shilmaydi. Bo'sh qolgan majburiy qiymat bo'lsa, server ishga tushmaydi.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shirinliklar?schema=public
# Mobil ilova Origin yubormaydi; bu yerga faqat veb-panel bo'lsa manzil yoziladi. "*" mumkin emas.
CORS_ORIGINS=https://admin.example.com
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=https://storage.googleapis.com/BUCKET
DELIVERY_FEE=15000
ORDER_MIN_LEAD_MINUTES=60
ORDER_MAX_DAYS_AHEAD=60
STORE_UTC_OFFSET_MINUTES=300
# Backendning tashqi HTTPS manzili (to'lov callback'lari shu manzilga keladi)
PUBLIC_BASE_URL=https://api.example.com
PAYMENT_PROVIDER=click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
