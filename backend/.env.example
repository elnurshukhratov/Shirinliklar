NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shirinliklar?schema=public
# Vergul bilan ajratilgan ruxsat etilgan manzillar ("*" faqat development uchun)
CORS_ORIGINS=*
# Firebase Auth (4-bosqichda ishlatiladi)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Rasmlar saqlash joyi (5-bosqichda ishlatiladi)
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
# Buyurtma sozlamalari: yetkazish narxi (so'm), buyurtma uchun eng kam oldindan vaqt (daqiqa), eng ko'p necha kun oldin
DELIVERY_FEE=15000
ORDER_MIN_LEAD_MINUTES=60
ORDER_MAX_DAYS_AHEAD=60
# Seed uchun admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Shirinliklar
# Onlayn to'lov (11-bosqich): backendning tashqi HTTPS manzili va Click kalitlari
PUBLIC_BASE_URL=
PAYMENT_PROVIDER=click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Do'kon vaqt mintaqasi (UTC dan daqiqalarda; Toshkent = 300). "Bugun buyurtma qabul qilmaymiz" kun oxirigacha amal qiladi
STORE_UTC_OFFSET_MINUTES=300
